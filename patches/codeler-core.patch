+/* Codeler: expanded activity bar with labels (reference image 3) */
+.monaco-workbench .activitybar.codeler-expanded > .content .monaco-action-bar .action-item {
+	width: auto;
+	margin: 2px 8px;
+	border-radius: 6px;
+	display: flex;
+	align-items: center;
+}
+.monaco-workbench .activitybar .codeler-label { display: none; }
+.monaco-workbench .activitybar.codeler-expanded > .content .monaco-action-bar .action-item > .codeler-label {
+	display: block;
+	margin-left: 2px;
+	font-size: 15px;
+	color: var(--vscode-activityBar-inactiveForeground);
+	white-space: nowrap;
+	pointer-events: none;
+}
+/* The expanded bar only shows while the Team page is open, so Team is the selected row (the side bar itself is hidden, which clears `.checked`). */
