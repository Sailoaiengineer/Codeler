@@ -0,0 +1,69 @@
+/* Codeler title bar items (sizes measured from the reference screenshots, scaled to a 48px bar) */
+.monaco-workbench .part.titlebar .codeler-title-left,
+.monaco-workbench .part.titlebar .codeler-title-right {
+	display: flex;
+	align-items: center;
+	height: 100%;
+	-webkit-app-region: no-drag;
+}
+.monaco-workbench .part.titlebar .codeler-title-left { gap: 28px; }
+.monaco-workbench .part.titlebar .codeler-title-right { gap: 12px; margin-right: 10px; }
+
+.monaco-workbench .part.titlebar .codeler-title-left button,
+.monaco-workbench .part.titlebar .codeler-title-right button {
+	display: inline-flex;
+	align-items: center;
+	gap: 7px;
+	border: 0;
+	background: none;
+	color: var(--vscode-titleBar-activeForeground);
+	font: inherit;
+	cursor: pointer;
+	-webkit-app-region: no-drag;
+}
+.monaco-workbench .part.titlebar .codeler-title-left button:focus-visible,
+.monaco-workbench .part.titlebar .codeler-title-right button:focus-visible { outline: 1px solid var(--vscode-focusBorder); outline-offset: 2px; }
+
+.monaco-workbench .part.titlebar .codeler-picker { font-size: 14px; padding: 4px 6px; border-radius: 6px; }
+.monaco-workbench .part.titlebar .codeler-picker:first-child { font-weight: 600; font-size: 15px; }
+.monaco-workbench .part.titlebar .codeler-picker:hover { background: rgba(255, 255, 255, 0.06); }
+.monaco-workbench .part.titlebar .codeler-picker .codicon-chevron-down { font-size: 13px; opacity: .8; }
+
+.monaco-workbench .part.titlebar .codeler-avatars { padding: 0 6px 0 0; }
+.monaco-workbench .part.titlebar .codeler-avatar {
+	width: 30px; height: 30px; border-radius: 50%;
+	display: inline-grid; place-items: center; overflow: hidden;
+	font-size: 12px; font-weight: 600; color: #fff;
+	box-shadow: 0 0 0 2px var(--vscode-titleBar-activeBackground);
+	margin-left: -7px;
+}
+.monaco-workbench .part.titlebar .codeler-avatar:first-child { margin-left: 0; }
+.monaco-workbench .part.titlebar .codeler-avatar img { width: 100%; height: 100%; object-fit: cover; }
+.monaco-workbench .part.titlebar .codeler-avatar.more { background: #1b3453; color: #c9d6ea; }
+
+.monaco-workbench .part.titlebar .codeler-btn {
+	height: 32px; padding: 0 15px; border-radius: 6px;
+	font-size: 14px; font-weight: 600;
+}
+.monaco-workbench .part.titlebar .codeler-btn.green { background: #2fb85a; color: #fff; }
+.monaco-workbench .part.titlebar .codeler-btn.green:hover { background: #36c865; }
+.monaco-workbench .part.titlebar .codeler-btn.outline { background: #0e2a4a; box-shadow: inset 0 0 0 1px #4f74a3; }
+.monaco-workbench .part.titlebar .codeler-btn.outline:hover { background: #133459; }
+.monaco-workbench .part.titlebar .codeler-btn .codicon { font-size: 15px; }
+
+.monaco-workbench .part.titlebar .codeler-icon { position: relative; width: 32px; height: 32px; justify-content: center; border-radius: 6px; }
+.monaco-workbench .part.titlebar .codeler-icon:hover { background: rgba(255, 255, 255, 0.06); }
+.monaco-workbench .part.titlebar .codeler-icon .codicon { font-size: 18px; }
+.monaco-workbench .part.titlebar .codeler-dot {
+	position: absolute; top: 6px; right: 7px; width: 7px; height: 7px; border-radius: 50%;
+	background: #2684f5; box-shadow: 0 0 0 2px var(--vscode-titleBar-activeBackground);
+}
+
+/* the window title text is not used in Codeler; the project picker replaces it */
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-center > .window-title { display: none; }
+.monaco-workbench .part.titlebar .codeler-account img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
+
+/* Logo first, centred over the 48px activity bar (image 1), then the project and branch pickers */
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-left > .codeler-title-left { order: 2; margin-left: 10px; }
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-left > .window-appicon { width: 48px; }
+.monaco-workbench .part.titlebar > .titlebar-container > .titlebar-left > .window-appicon:not(.codicon) { background-size: 28px; }
