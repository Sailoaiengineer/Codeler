+.monaco-workbench .activitybar.codeler-expanded > .content .monaco-action-bar .action-item { justify-content: flex-start; overflow: visible; }
+.monaco-workbench .activitybar.codeler-expanded > .content .monaco-action-bar .action-item .action-label { flex: none; width: 40px !important; }
+.monaco-workbench .activitybar.codeler-expanded > .content .monaco-action-bar .action-item .badge { left: 22px; }
+.monaco-workbench .activitybar.codeler-expanded .menubar { width: 48px; }
diff --git a/src/vs/workbench/browser/parts/titlebar/codelerTitlebar.ts b/src/vs/workbench/browser/parts/titlebar/codelerTitlebar.ts
new file mode 100644
index 00000000..b425599f
--- /dev/null
+++ b/src/vs/workbench/browser/parts/titlebar/codelerTitlebar.ts
@@ -0,0 +1,127 @@
+/*---------------------------------------------------------------------------------------------
+ *  Codeler: project/branch pickers on the left of the title bar and avatars, Share, Run/Save
+ *  and the bell on the right. The Codeler built-in extension owns the data and pushes it here
+ *  with the `_codeler.titlebar.setState` command; clicks run the extension's commands.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/codeler.css';
+import { $, append, addDisposableListener, EventType, reset } from '../../../../base/browser/dom.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ThemeIcon } from '../../../../base/common/themables.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+
+export interface ICodelerPerson { name: string; initials: string; color: string; photo?: string }
+export interface ICodelerTitlebarState {
+	mode: 'team' | 'solo';
+	project: string;
+	branch: string;
+	people: ICodelerPerson[];
+	unread: number;
+	dirty: boolean;
+	account?: { name: string; photo?: string };
+	/** A full-window page (image 3: Team) shows only the project picker. */
+	page?: 'team';
+}
+
+const MAX_AVATARS = 3;
+let state: ICodelerTitlebarState | undefined;
+const onDidChange = new Emitter<void>();
+
+const str = (v: unknown, max: number) => typeof v === 'string' ? v.slice(0, max) : '';
+const color = (v: unknown) => typeof v === 'string' && /^#[0-9a-f]{3,8}$/i.test(v) ? v : '#2684f5';
+
+// Extensions can call this, so treat the payload as untrusted.
+CommandsRegistry.registerCommand('_codeler.titlebar.setState', (_accessor, raw: Partial<ICodelerTitlebarState> | undefined) => {
+	if (!raw || typeof raw !== 'object') {
+		state = undefined;
+	} else {
+		state = {
+			mode: raw.mode === 'team' ? 'team' : 'solo',
+			project: str(raw.project, 80),
+			branch: str(raw.branch, 60),
+			people: (Array.isArray(raw.people) ? raw.people : []).slice(0, 200).map(p => ({
+				name: str(p?.name, 60), initials: str(p?.initials, 2), color: color(p?.color),
+				photo: typeof p?.photo === 'string' && /^https:\/\//.test(p.photo) ? p.photo : undefined,
+			})),
+			unread: Math.max(0, Math.min(999, Number(raw.unread) || 0)),
+			dirty: !!raw.dirty,
+			page: raw.page === 'team' ? 'team' : undefined,
+			account: raw.account && typeof raw.account === 'object' ? {
+				name: str(raw.account.name, 60),
+				photo: typeof raw.account.photo === 'string' && /^https:\/\//.test(raw.account.photo) ? raw.account.photo : undefined,
+			} : undefined,
+		};
+	}
+	onDidChange.fire();
+});
+
+export function installCodelerTitlebar(left: HTMLElement, right: HTMLElement, commands: ICommandService): DisposableStore {
+	const store = new DisposableStore();
+	const leftSlot = append(left, $('div.codeler-title-left'));
+	const rightSlot = append(right, $('div.codeler-title-right'));
+	const run = (id: string) => commands.executeCommand(id);
+
+	const button = (cls: string, label: string, icon: ThemeIcon | undefined, cmd: string, text?: string) => {
+		const b = $(`button.${cls}`, { type: 'button', 'aria-label': label, title: label });
+		if (icon) { b.append(renderIcon(icon)); }
+		if (text) { b.append($('span', undefined, text)); }
+		store.add(addDisposableListener(b, EventType.CLICK, () => run(cmd)));
+		return b;
+	};
+	const picker = (icon: ThemeIcon | undefined, text: string, label: string, cmd: string) => {
+		const b = button('codeler-picker', label, icon, cmd, text);
+		b.append(renderIcon(Codicon.chevronDown));
+		return b;
+	};
+
+	const render = () => {
+		if (!state) {
+			reset(leftSlot);
+			reset(rightSlot);
+			return;
+		}
+		const project = picker(undefined, state.project || 'Open project', 'Switch project', 'codeler.pickProject');
+		if (state.page) {
+			reset(leftSlot, project);
+			reset(rightSlot);
+			return;
+		}
+		reset(leftSlot, project, picker(Codicon.gitBranch, state.branch || 'main', 'Version history', 'codeler.pickBranch'));
+
+		const items: HTMLElement[] = [];
+		if (state.mode === 'team' && state.people.length) {
+			const stack = button('codeler-avatars', `${state.people.length} collaborators`, undefined, 'workbench.view.extension.codeler-collaborators');
+			for (const p of state.people.slice(0, MAX_AVATARS)) {
+				const a = append(stack, $('span.codeler-avatar', { title: p.name }));
+				a.style.backgroundColor = p.color;
+				if (p.photo) { append(a, $('img', { src: p.photo, alt: '' })); } else { a.textContent = p.initials; }
+			}
+			if (state.people.length > MAX_AVATARS) { append(stack, $('span.codeler-avatar.more', undefined, `+${state.people.length - MAX_AVATARS}`)); }
+			items.push(stack, button('codeler-btn.green', 'Share preview', Codicon.link, 'codeler.share', 'Share'));
+		}
+		const runBtn = button('codeler-btn.green', 'Run', Codicon.play, 'codeler.run', 'Run');
+		const gear = button('codeler-icon', 'Settings', Codicon.settingsGear, 'workbench.action.openSettings');
+		if (state.mode === 'solo') {
+			// image 2 order: gear, Save, Run
+			items.push(gear, button('codeler-btn.outline', 'Save', Codicon.save, 'workbench.action.files.save', 'Save'), runBtn);
+		} else {
+			// image 1 order: avatars, Share, Run, gear, bell, account
+			items.push(runBtn, gear);
+			const bell = button('codeler-icon', state.unread ? `${state.unread} notifications` : 'Notifications', Codicon.bell, 'codeler.notifications');
+			if (state.unread) { append(bell, $('span.codeler-dot')); }
+			// Account: your Google photo once signed in, otherwise a sign-in button. Not in image 2 (solo), so team only.
+			const who = state.account;
+			const account = button('codeler-icon.codeler-account', who ? `Signed in as ${who.name}` : 'Sign in', who?.photo ? undefined : Codicon.account, 'codeler.account');
+			if (who?.photo) { append(account, $('img', { src: who.photo, alt: '', referrerpolicy: 'no-referrer' })); }
+			items.push(bell, account);
+		}
+		reset(rightSlot, ...items);
+	};
+
+	render();
+	store.add(onDidChange.event(render));
+	return store;
+}
