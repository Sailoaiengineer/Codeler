{
  "name": "codeler",
  "displayName": "Codeler",
  "description": "Teams, live editing and chat for Codeler.",
  "version": "0.1.0",
  "publisher": "codeler",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Codeler Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/codeler-dark.json"
      }
    ],
    "colors": [
      { "id": "codeler.person1", "description": "Codeler collaborator color 1", "defaults": { "dark": "#3fbf5c", "light": "#3fbf5c", "highContrast": "#3fbf5c" } },
      { "id": "codeler.person2", "description": "Codeler collaborator color 2", "defaults": { "dark": "#2684f5", "light": "#2684f5", "highContrast": "#2684f5" } },
      { "id": "codeler.person3", "description": "Codeler collaborator color 3", "defaults": { "dark": "#f2842b", "light": "#f2842b", "highContrast": "#f2842b" } },
      { "id": "codeler.person4", "description": "Codeler collaborator color 4", "defaults": { "dark": "#b26bd1", "light": "#b26bd1", "highContrast": "#b26bd1" } }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Codeler Dark",
      "editor.fontFamily": "'JetBrains Mono', Consolas, 'Courier New', monospace",
      "editor.fontSize": 15,
      "editor.lineHeight": 25,
      "editor.minimap.enabled": false,
      "editor.renderLineHighlight": "none",
      "workbench.tree.indent": 14,
      "workbench.editor.tabSizing": "fit",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "git.enabled": false,
      "chat.disableAIFeatures": true,
      "breadcrumbs.enabled": false,
      "workbench.experimental.modernUI": false
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeler-team",
          "title": "Team",
          "icon": "$(organization)"
        },
        {
          "id": "codeler-workspaces",
          "title": "Workspaces",
          "icon": "$(package)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "codeler-chat",
          "title": "Chat",
          "icon": "$(comment)"
        },
        {
          "id": "codeler-activity",
          "title": "Activity",
          "icon": "$(zap)"
        },
        {
          "id": "codeler-collaborators",
          "title": "Collaborators",
          "icon": "$(person-add)"
        }
      ]
    },
    "views": {
      "codeler-team": [
        {
          "type": "webview",
          "id": "codeler.team",
          "name": "Team"
        }
      ],
      "codeler-chat": [
        {
          "type": "webview",
          "id": "codeler.chat",
          "name": "Chat"
        }
      ],
      "codeler-activity": [
        {
          "type": "webview",
          "id": "codeler.activity",
          "name": "Activity"
        }
      ],
      "codeler-collaborators": [
        {
          "type": "webview",
          "id": "codeler.collaborators",
          "name": "Collaborators"
        }
      ],
      "codeler-workspaces": [
        {
          "type": "webview",
          "id": "codeler.workspaces",
          "name": "Workspaces"
        }
      ],
      "extensions": [
        {
          "id": "codeler.extensionPicks",
          "name": "Codeler picks"
        }
      ]
    },
    "commands": [
      {
        "command": "codeler.createTeam",
        "title": "Create your team",
        "category": "Codeler",
        "icon": "$(organization)"
      },
      {
        "command": "codeler.share",
        "title": "Share preview",
        "category": "Codeler",
        "icon": "$(link)"
      },
      {
        "command": "codeler.run",
        "title": "Run",
        "category": "Codeler",
        "icon": "$(play)"
      },
      {
        "command": "codeler.toggleSampleCursors",
        "title": "Show sample teammate cursors (layout preview)",
        "category": "Codeler"
      },
      {
        "command": "codeler.switchLayoutPreview",
        "title": "Switch layout preview (team / solo)",
        "category": "Codeler"
      },
      {
        "command": "codeler.pickProject",
        "title": "Switch project",
        "category": "Codeler"
      },
      {
        "command": "codeler.pickBranch",
        "title": "Version history",
        "category": "Codeler"
      },
      {
        "command": "codeler.notifications",
        "title": "Notifications",
        "category": "Codeler"
      },
      {
        "command": "codeler.account",
        "title": "Your account",
        "category": "Codeler"
      },
      {
        "command": "codeler.signIn",
        "title": "Sign in with Google",
        "category": "Codeler"
      },
      {
        "command": "codeler.signOut",
        "title": "Sign out",
        "category": "Codeler"
      },
      {
        "command": "codeler.picks.choose",
        "title": "Open pick",
        "category": "Codeler"
      }
    ],
    "configuration": {
      "title": "Codeler",
      "properties": {
        "codeler.layoutPreview": {
          "type": "string",
          "enum": [
            "team",
            "solo"
          ],
          "default": "team",
          "description": "Temporary: which reference layout to show with sample data until login and teams are connected."
        },
        "codeler.siteUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Address of the Codeler sign-in site."
        },
        "codeler.convexUrl": {
          "type": "string",
          "default": "",
          "description": "Address of the Codeler Convex backend (https://<deployment>.convex.cloud)."
        },
        "codeler.projectId": {
          "type": "string",
          "default": "",
          "description": "Temporary Convex project ID for the open team project; the Workspaces picker will provide this later."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "codeler.createTeam",
          "when": "view == codeler.workspaces",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeler.picks.choose",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {},
  "dependencies": {
    "convex": "^1.48.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
