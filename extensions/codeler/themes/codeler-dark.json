{
  "$schema": "vscode://schemas/color-theme",
  "name": "Codeler Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#2684f5",
    "foreground": "#c9d6ea",
    "descriptionForeground": "#8b9ebc",
    "widget.border": "#11273f",
    "icon.foreground": "#c9d6ea",

    "titleBar.activeBackground": "#0b1f39",
    "titleBar.inactiveBackground": "#0b1f39",
    "titleBar.activeForeground": "#e8f1ff",
    "titleBar.border": "#11273f",
    "commandCenter.background": "#0f243f",
    "commandCenter.border": "#1b3453",

    "activityBar.background": "#081a31",
    "activityBar.foreground": "#e8f1ff",
    "activityBar.inactiveForeground": "#8fb0d8",
    "activityBar.activeBorder": "#00000000",
    "activityBar.border": "#11273f",
    "activityBarBadge.background": "#2684f5",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#081a30",
    "sideBar.foreground": "#c9d6ea",
    "sideBar.border": "#11273f",
    "sideBarTitle.foreground": "#e8f1ff",
    "sideBarSectionHeader.background": "#081a30",
    "sideBarSectionHeader.border": "#00000000",
    "list.activeSelectionBackground": "#16345a",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#16345a",
    "list.hoverBackground": "#10284a",
    "list.focusOutline": "#00000000",
    "tree.indentGuidesStroke": "#1b3453",

    "editor.background": "#041628",
    "editor.foreground": "#d7e3f4",
    "editorLineNumber.foreground": "#5f7699",
    "editorLineNumber.activeForeground": "#c9d6ea",
    "editor.lineHighlightBackground": "#0a2038",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#1d3d66",
    "editorCursor.foreground": "#2684f5",
    "editorIndentGuide.background1": "#13294a",
    "editorWhitespace.foreground": "#1b3453",
    "editorGutter.background": "#041628",
    "editorGroupHeader.tabsBackground": "#071a30",
    "editorGroupHeader.tabsBorder": "#11273f",
    "editorGroup.border": "#11273f",

    "tab.activeBackground": "#11294b",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#071a30",
    "tab.inactiveForeground": "#c9d6ea",
    "tab.border": "#071a30",
    "tab.activeBorderTop": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.unfocusedActiveBackground": "#11294b",
    "tab.activeModifiedBorder": "#2684f5",

    "panel.background": "#03152b",
    "panel.border": "#11273f",
    "panelTitle.activeForeground": "#ffffff",
    "panelTitle.inactiveForeground": "#8b9ebc",
    "panelTitle.activeBorder": "#2684f5",
    "terminal.background": "#03152b",
    "terminal.foreground": "#e5f0ff",

    "statusBar.background": "#081c34",
    "statusBar.foreground": "#c9d6ea",
    "statusBar.border": "#11273f",
    "statusBar.noFolderBackground": "#081c34",
    "statusBar.debuggingBackground": "#081c34",
    "statusBarItem.remoteBackground": "#081c34",

    "button.background": "#2b9bf4",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#41a8f6",
    "button.secondaryBackground": "#0f2a48",
    "button.secondaryForeground": "#e8f1ff",
    "input.background": "#08223d",
    "input.border": "#1b3453",
    "input.foreground": "#e8f1ff",
    "input.placeholderForeground": "#809abd",
    "dropdown.background": "#08223d",
    "dropdown.border": "#1b3453",
    "badge.background": "#2684f5",
    "badge.foreground": "#ffffff",
    "textLink.foreground": "#4aa8ff",
    "scrollbarSlider.background": "#1b345380",
    "scrollbarSlider.hoverBackground": "#2a4a70a0",
    "menu.background": "#0b1f39",
    "menu.border": "#1b3453",
    "quickInput.background": "#0b1f39",
    "notifications.background": "#0b1f39",
    "editorWidget.background": "#0b1f39"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6a81a3", "fontStyle": "" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.control.import", "keyword.control.from"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.import variable"], "settings": { "foreground": "#d7e3f4" } },
    { "scope": ["variable.other.constant", "variable.other.object.property", "support.variable.property"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["support.variable", "support.class", "entity.name.type", "entity.name.class"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f07178" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c792ea" } }
  ]
}
