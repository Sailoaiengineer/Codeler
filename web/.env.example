# Next.js (web/.env.local)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site

# Convex dashboard env vars (npx convex env set NAME value)
# SITE_URL=http://localhost:3000            the URL this Next.js site runs on
# BETTER_AUTH_SECRET=<random 32+ chars>      npx convex env set BETTER_AUTH_SECRET $(openssl rand -base64 32)
# GOOGLE_CLIENT_ID=...                       from Google Cloud console, OAuth client (Web application)
# GOOGLE_CLIENT_SECRET=...
# Authorized redirect URI in Google: <SITE_URL>/api/auth/callback/google
